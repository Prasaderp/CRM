{
  "name": "real-estate-crm-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
