# Local Environment Configuration
ENVIRONMENT=local

# Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5433/real_estate_crm
TEST_DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5433/real_estate_crm_test

# Public Origin — must match the origin the browser actually loads the SPA from.
# Vite binds 127.0.0.1, so that is the canonical local origin; localhost is trusted too.
PUBLIC_ORIGIN=http://127.0.0.1:5173
TRUSTED_ORIGINS=http://localhost:5173

# Canonical Notice
CANONICAL_NOTICE_VERSION=2026-07-30
CANONICAL_NOTICE_TEXT="By submitting this form, you agree to our privacy policy and consent to being contacted regarding your real estate inquiry."

# SMTP Configuration (Mailpit locally)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SENDER=leads@client.example

# Recipient Allow-List (comma separated)
RECIPIENT_ALLOW_LIST=agent@leads.client.example,admin@leads.client.example

# SMTP transport security: starttls | tls | none
# Mailpit locally is plaintext. Any non-local environment must use starttls or tls.
SMTP_SECURITY=none
